{
  "buildCommand": "cd packages/web && bun run build",
  "outputDirectory": "packages/web/dist",
  "installCommand": "bun install",
  "rewrites": [
    {
      "source": "/terminos",
      "destination": "/index.html"
    },
    {
      "source": "/privacidad",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=31536000, immutable"
        }
      ]
    }
  ]
}
